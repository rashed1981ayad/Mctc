NODE_ENV=development
PORT=5000
BIND_HOST=127.0.0.1
# أضف عناوين IP محددة فقط إذا كان الوكيل العكسي يتصل من غير loopback.
# TRUSTED_PROXY_IPS=192.0.2.10

# Runtime only: create this limited role using deploy/postgres-runtime-grants.sql.
# Use a separate MIGRATION_DATABASE_URL for db:prepare; never put it in this file.
DATABASE_URL=postgres://mctc_runtime:your_password@localhost:5432/almutqaddim

ADMIN_EMAIL= 
ADMIN_PASSWORD=replace_with_a_strong_password_of_16_characters_or_more
ADMIN_HOST=admin.mctc.ly
ADMIN_URL=http://127.0.0.1:5174

CLIENT_URL=https://mctc.ly,https://www.mctc.ly,https://admin.mctc.ly,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174
# اختياري للطلبات العامة عبر نطاق مختلف فقط؛ لوحة الإدارة لا تستخدم CORS.
# PUBLIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TURNSTILE_SECRET_KEY=replace_with_cloudflare_turnstile_secret
# في وضع development تُستخدم مفاتيح Cloudflare التجريبية تلقائيًا عند غياب هذين السطرين.
# في الإنتاج يجب إعداد Widget حقيقي خاص بـ admin.mctc.ly؛ مفاتيح الاختبار مرفوضة.
# ADMIN_TURNSTILE_SITE_KEY=replace_with_admin_turnstile_site_key
# ADMIN_TURNSTILE_SECRET_KEY=replace_with_admin_turnstile_secret_key
# اختياري: أسماء النطاقات المسموحة لرموز الإدارة (من دون بروتوكول أو منفذ).
# ADMIN_TURNSTILE_HOSTNAMES=admin.mctc.ly,localhost,127.0.0.1,admin.localhost
CONTACT_WHATSAPP_NUMBER=218000000000
# الحد الأقصى الإجمالي للملفات المرفوعة بالبايت (افتراضيًا 1 GiB)
UPLOAD_MAX_BYTES=1073741824

# PDF uploads require qpdf and ClamAV with current virus definitions.
# Optional absolute executable/database paths; otherwise use PATH.
# Windows development also detects the portable tools in server/.tools.
# PDF_QPDF_PATH=/usr/bin/qpdf
# PDF_CLAMSCAN_PATH=/usr/bin/clamscan
# PDF_CLAMAV_DATABASE=/var/lib/clamav
